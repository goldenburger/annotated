{
  "manifest_version": 3,
  "name": "annotated",
  "version": "2.13.0",
  "description": "Highlight a passage, clip a video or podcast, or save a post, then say what you think. Every annotation links back to its source.",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "contextMenus",
    "storage",
    "tabCapture",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "annotated",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "capture-engine.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "post-core.js",
        "article-core.js",
        "capture-engine.js",
        "article.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Alt+Shift+K"
      },
      "description": "Open the annotated side panel"
    },
    "annotate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Annotate the selected passage"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel.html",
        "*.js",
        "*.css",
        "fonts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}